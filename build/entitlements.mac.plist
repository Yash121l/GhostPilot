<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for Electron's V8 JIT -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required for Electron's unsigned memory -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for Electron's DYLD env vars -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Required for keytar to access macOS Keychain -->
    <key>keychain-access-groups</key>
    <array>
      <string>$(AppIdentifierPrefix)com.ghostpilot.app</string>
    </array>
    <!-- Required for outbound network requests (LinkedIn, X, Instagram APIs) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Required for localhost OAuth fallback server -->
    <key>com.apple.security.network.server</key>
    <true/>
  </dict>
</plist>
