# GhostPilot — Environment Variables
# Only BUILD-TIME variables go here. NEVER put secrets or API keys in this file.
# Runtime secrets are stored in the OS keychain via keytar.

# Electron auto-updater — set to your GitHub repo
# GH_TOKEN is injected by CI. Never commit a real token here.
GH_TOKEN=

# Optional: override app name for dev builds
VITE_APP_NAME="GhostPilot"
