# GhostPilot — Environment Variables
# Only BUILD-TIME variables go here. NEVER put secrets or API keys in this file.
# Runtime secrets (AI keys, OAuth tokens) are stored in the OS keychain via keytar.

# Electron auto-updater — set to your GitHub repo
# GH_TOKEN is injected by CI. Never commit a real token here.
GH_TOKEN=

# Optional: override app name for dev builds
VITE_APP_NAME="GhostPilot"

# ─── LinkedIn OAuth App ───────────────────────────────────────────────────────
# Create an app at https://www.linkedin.com/developers/apps
# Add redirect URI: ghostpilot://oauth/callback
# Request products: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── X (Twitter) OAuth App ───────────────────────────────────────────────────
# Create an app at https://developer.twitter.com/en/portal/dashboard
# Add redirect URI: ghostpilot://oauth/callback
# Enable OAuth 2.0 with PKCE, request scopes: tweet.read tweet.write users.read offline.access
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ─── Instagram / Meta OAuth App ──────────────────────────────────────────────
# Create an app at https://developers.facebook.com/apps
# Add Instagram Basic Display or Instagram Graph API product
# Add redirect URI: ghostpilot://oauth/callback
META_APP_ID=
META_APP_SECRET=
